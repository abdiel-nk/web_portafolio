---
import SiteLayout from "@/layouts/SiteLayout.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import { projects } from "@/data/projects";

const expertise = [
  { name: "Frontend", detail: "Angular · React · TypeScript · JavaScript" },
  { name: "Backend", detail: "Laravel · Node.js · REST APIs" },
  { name: "Data", detail: "Oracle · PostgreSQL · Supabase" },
  { name: "Workflow", detail: "Git · Docker · API integration" },
];
---
<SiteLayout>
  <main id="top">
    <section class="hero section-shell" aria-labelledby="hero-title">
      <div class="hero-grid" aria-hidden="true"></div>
      <div class="hero-copy">
        <p class="eyebrow hero-kicker"><span class="status-dot"></span> FULL STACK DEVELOPER <span class="kicker-location">· PERU</span></p>
        <h1 id="hero-title">Building<br /><span class="text-muted">digital</span> things<br />with <span class="text-accent">purpose.</span></h1>
        <div class="hero-bottom">
          <p class="hero-intro">I turn ideas and complex requirements into thoughtful, useful web experiences — from interface to backend.</p>
          <a class="round-link" href="#work" aria-label="Explore selected work"><span>↓</span></a>
        </div>
      </div>
      <div class="hero-side-note" aria-hidden="true"><span>DESIGN</span><i></i><span>ENGINEER</span><i></i><span>ITERATE</span></div>
      <div class="hero-visual" aria-hidden="true">
        <div class="visual-ring ring-one"></div>
        <div class="visual-ring ring-two"></div>
        <div class="visual-core"><span>A</span></div>
        <div class="visual-cross cross-one"></div>
        <div class="visual-cross cross-two"></div>
        <span class="visual-coordinate">-12.0464° / -77.0428°</span>
        <span class="visual-caption">A CONTINUOUS PROCESS<br />OF LEARNING & BUILDING</span>
      </div>
      <div class="hero-index"><span>SCROLL TO EXPLORE</span><span>01 — 04</span></div>
    </section>

    <section class="intro-section section-shell" id="about">
      <div class="section-label reveal"><span>01</span><span>THE PERSON BEHIND THE CODE</span></div>
      <div class="intro-content reveal">
        <p class="eyebrow">A LITTLE ABOUT ME</p>
        <h2>I care about the details —<span class="text-muted"> and the bigger picture.</span></h2>
        <div class="intro-columns">
          <p>I'm a developer who enjoys connecting the pieces of a product: understanding a problem, shaping an interface, building the logic behind it, and making the whole experience feel coherent.</p>
          <p>I'm continuously learning, exploring better ways to build, and looking for opportunities to contribute to products with real users and meaningful challenges.</p>
        </div>
        <a class="text-link" href="https://github.com/abdiel-nk" target="_blank" rel="noreferrer">Explore my GitHub <span>↗</span></a>
      </div>
    </section>

    <section class="expertise-section section-shell" id="expertise">
      <div class="section-label reveal"><span>02</span><span>WHAT I WORK WITH</span></div>
      <div class="expertise-heading reveal">
        <p class="eyebrow">TOOLS & TECHNOLOGIES</p>
        <h2>Versatile by nature.<br /><span class="text-muted">Focused on the solution.</span></h2>
      </div>
      <div class="expertise-list">
        {expertise.map((item, index) => (
          <article class="expertise-row reveal">
            <span class="expertise-index">0{index + 1}</span>
            <h3>{item.name}</h3>
            <p>{item.detail}</p>
            <span class="expertise-arrow" aria-hidden="true">↗</span>
          </article>
        ))}
      </div>
      <p class="section-footnote">A selection of technologies I've worked with. The stack depends on the problem, not the trend.</p>
    </section>

    <section class="work-section section-shell" id="work">
      <div class="section-label reveal"><span>03</span><span>SELECTED WORK</span></div>
      <div class="work-heading reveal">
        <div><p class="eyebrow">A FEW THINGS I'VE BUILT</p><h2>Selected <span class="text-muted">projects.</span></h2></div>
        <p>Small snapshots of how I approach interfaces, functionality, and the details that bring products together.</p>
      </div>
      <div class="projects-grid">
        {projects.map((project) => <ProjectCard {...project} />)}
      </div>
      <a class="text-link all-work-link" href="https://github.com/abdiel-nk" target="_blank" rel="noreferrer">More on GitHub <span>↗</span></a>
    </section>

    <section class="contact-section section-shell" id="contact">
      <div class="section-label reveal"><span>04</span><span>HAVE A GOOD CHALLENGE?</span></div>
      <div class="contact-content reveal">
        <p class="eyebrow">LET'S BUILD SOMETHING</p>
        <h2>Good work starts<br />with a <span class="text-accent">conversation.</span></h2>
        <a class="contact-link" href="https://www.linkedin.com/in/abdiel-mamani-simeon-6865a51b6/" target="_blank" rel="noreferrer">Connect on LinkedIn <span>↗</span></a>
      </div>
      <div class="contact-orbit" aria-hidden="true"></div>
    </section>
  </main>
  <footer class="site-footer section-shell">
    <a class="brand" href="#top"><span class="brand-mark">A<span>.</span></span><span class="brand-name">ABDIEL<span class="brand-divider">/</span>DEV</span></a>
    <p>Designed & built with intention.</p>
    <a href="#top">BACK TO TOP ↑</a>
    <span>© {new Date().getFullYear()} ABDIEL</span>
  </footer>
</SiteLayout>
