---
const links = [
  { label: "About", href: "#about" },
  { label: "Expertise", href: "#expertise" },
  { label: "Work", href: "#work" },
  { label: "Contact", href: "#contact" },
];
---
<header class="site-header">
  <a class="brand" href="#top" aria-label="Abdiel, back to top">
    <span class="brand-mark">A<span>.</span></span>
    <span class="brand-name">ABDIEL<span class="brand-divider">/</span>DEV</span>
  </a>
  <button class="menu-toggle" type="button" aria-label="Open navigation" aria-expanded="false" aria-controls="primary-navigation">
    <span></span><span></span>
  </button>
  <nav class="main-nav" id="primary-navigation" aria-label="Main navigation">
    {links.map((link) => <a href={link.href}>{link.label}</a>)}
    <a class="nav-availability" href="mailto:">Let's talk <span aria-hidden="true">↗</span></a>
  </nav>
</header>
